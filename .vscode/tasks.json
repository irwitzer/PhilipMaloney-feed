{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Patch vollständig prüfen",
      "type": "shell",
      "command": "powershell.exe",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}\\scripts\\check-patch.ps1"
      ],
      "group": {
        "kind": "test",
        "isDefault": true
      },
      "problemMatcher": []
    },
    {
      "label": "Ruff prüfen",
      "type": "shell",
      "command": "uv run ruff check .",
      "group": "test",
      "problemMatcher": []
    },
    {
      "label": "Ruff automatisch korrigieren",
      "type": "shell",
      "command": "uv run ruff check . --fix",
      "group": "test",
      "problemMatcher": []
    },
    {
      "label": "Tests ausführen",
      "type": "shell",
      "command": "uv run pytest",
      "group": "test",
      "problemMatcher": []
    }
  ]
}
